rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admin list: you add admins by hand in the Firebase Console. The website can never write here.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admin can change everything. A customer may ONLY lower the stock number (when buying).
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock);
    }
    match /customers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // New customers always start with credit limit 0.
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.creditLimit == 0;
      // Customers can edit their own profile but NEVER their own credit limit. Admin can edit it.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
                        && request.resource.data.creditLimit == resource.data.creditLimit);
      allow delete: if false;
    }
    match /carts/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
    match /orders/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Placed'
        && request.resource.data.items.size() > 0
        && request.resource.data.creditSettled == false
        && request.resource.data.paymentMethod in ['Cash', 'Credit']
        && (request.resource.data.paymentMethod == 'Cash'
            || get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.creditLimit >= request.resource.data.total);
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
